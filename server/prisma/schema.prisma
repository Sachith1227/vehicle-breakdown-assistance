generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int                @id @default(autoincrement())
  name              String
  email             String             @unique
  password          String
  role              String             @default("DRIVER")
  createdAt         DateTime           @default(now())
  vehicles          Vehicle[]
  mechanic          Mechanic?
  breakdownRequests BreakdownRequest[]
}

model Vehicle {
  id                 Int      @id @default(autoincrement())
  userId             Int
  registrationNumber String   @unique
  make               String
  model              String
  year               Int
  createdAt          DateTime @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  breakdownRequests BreakdownRequest[]
}

model Mechanic {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  businessName String
  phone        String
  latitude     Float
  longitude    Float
  isAvailable  Boolean  @default(true)
  rating       Float    @default(0)
  createdAt    DateTime @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  breakdownRequests BreakdownRequest[]
}

model BreakdownRequest {
  id          Int      @id @default(autoincrement())
  userId      Int
  vehicleId   Int
  mechanicId  Int?
  problemType String
  description String?
  latitude    Float
  longitude   Float
  status      String   @default("REQUESTED")
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  mechanic Mechanic? @relation(fields: [mechanicId], references: [id], onDelete: SetNull)
}
